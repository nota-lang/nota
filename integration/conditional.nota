%let Toggle = () => {
  let [on, setOn] = createSignal(false);
  return @span[id: "toggle"]{
    @button[type: "button"][onClick: () => setOn(!on())]{toggle}
    @if (on()) {@em[id: "yes"]{shown}} else {@em[id: "no"]{hidden}}
  };
};

@Toggle{}

@if (1 > 0) {@p[id: "taken"]{always here}}

@if (1 > 2) {@p[id: "untaken"]{never here}}

%let Cycle = () => {
  let [n, setN] = createSignal(1);
  return @span[id: "cycle"]{
    @button[id: "advance", type: "button"][onClick: () => setN((n() + 1) % 3)]{advance}
    @if (n() === 0) {@em[id: "c-zero"]{zero}}
    else if (n() === 1) {@em[id: "c-one"]{one}}
    else {@em[id: "c-two"]{two}}
  };
};

@Cycle{}
