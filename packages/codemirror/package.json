{
  "name": "@nota-lang/codemirror",
  "version": "0.2.0",
  "description": "CodeMirror 6 language support for Nota, reader-driven: highlighting, embedded-language sub-tokenizing, and a shared highlight style.",
  "files": [
    "dist"
  ],
  "main": "dist/lib.js",
  "exports": {
    ".": {
      "default": "./dist/lib.js"
    },
    "./*": {
      "default": "./dist/*.js"
    }
  },
  "type": "module",
  "depot": {
    "platform": "browser",
    "target": "lib",
    "depot-version": "0.3.4"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/legacy-modes": "^6.5.3",
    "@nota-lang/compiler": "workspace:*"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.10.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@lezer/highlight": "^1.2.3"
  },
  "devDependencies": {
    "@codemirror/language": "^6.10.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@lezer/highlight": "^1.2.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nota-lang/nota.git",
    "directory": "packages/codemirror"
  }
}
