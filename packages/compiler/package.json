{
  "name": "@nota-lang/compiler",
  "version": "0.2.1",
  "description": "Node shim around the oxc Nota reader: compiles .nota source to Solid JSX with the ambient imports prepended.",
  "files": [
    "dist"
  ],
  "main": "dist/lib.js",
  "exports": {
    ".": {
      "default": "./dist/lib.js"
    },
    "./*": {
      "default": "./dist/*.js"
    }
  },
  "type": "module",
  "depot": {
    "platform": "node",
    "target": "lib",
    "depot-version": "0.3.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nota-lang/nota.git",
    "directory": "packages/compiler"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.0",
    "@shikijs/langs": "^4.4.3"
  }
}
