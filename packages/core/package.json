{
  "name": "@nota-lang/core",
  "version": "0.2.3",
  "description": "The Nota runtime.",
  "files": [
    "dist"
  ],
  "main": "dist/lib.jsx",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "solid": "./dist/lib.jsx",
      "default": "./dist/lib.jsx"
    },
    "./*": {
      "solid": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "type": "module",
  "sideEffects": false,
  "depot": {
    "platform": "browser",
    "target": "lib",
    "depot-version": "0.3.4"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.8",
    "solid-js": "^2.0.0-rc.8"
  },
  "devDependencies": {
    "@nota-lang/compiler": "workspace:*",
    "jsdom": "^29.1.1",
    "@solidjs/web": "2.0.0-rc.8",
    "solid-js": "2.0.0-rc.8",
    "vite": "^8.0.16",
    "@solidjs/vite-plugin": "3.0.0-next.43",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nota-lang/nota.git",
    "directory": "packages/core"
  }
}
