{
  "name": "@nota-lang/explorable",
  "version": "0.1.0",
  "description": "Interaction primitives for explorable explanations (Slider/Action/Sticky) as plain Solid components over document-declared state.",
  "files": [
    "dist",
    "css"
  ],
  "main": "dist/lib.js",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "solid": "./dist/lib.js",
      "default": "./dist/lib.js"
    },
