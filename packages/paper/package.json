{
  "name": "@nota-lang/paper",
  "version": "0.1.0",
  "description": "Academic-paper constructs over the Solid doc-state store: grammar/inference-rule DSLs and paper scaffolding (title/abstract/figures).",
  "files": [
    "dist",
    "css"
  ],
  "main": "dist/lib.js",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "solid": "./dist/lib.js",
      "default": "./dist/lib.js"
    },
    "./paper.css": "./css/paper.css"
  },
  "type": "module",
  "depot": {
    "platform": "browser",
    "target": "lib",
    "depot-version": "0.3.4"
  },
  "dependencies": {
    "@nota-lang/prelude": "workspace:*",
    "@nota-lang/core": "workspace:*"
  },
  "devDependencies": {
    "solid-js": "^1.9.3",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nota-lang/nota.git",
    "directory": "packages/paper"
  },
  "types": "dist/lib.d.ts",
  "peerDependencies": {
    "solid-js": "^1.9.0"
  }
}
