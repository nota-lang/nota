    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "jsdom": "^29.1.1",
    "solid-js": "^1.9.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nota-lang/nota.git",
    "directory": "packages/prelude"
