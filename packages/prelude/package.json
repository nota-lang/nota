{
  "name": "@nota-lang/prelude",
  "version": "0.1.0",
  "description": "The standard ambient prelude for Nota: Tex, code highlighting, doc-state components, and definition tooltips.",
  "files": [
    "dist"
  ],
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "default": "./dist/code.jsx"
    },
    "./def": {
      "types": "./dist/def.d.ts",
      "default": "./dist/def.jsx"
    },
    "./doc-state": {
      "types": "./dist/doc-state.d.ts",
      "default": "./dist/doc-state.jsx"
    },
    "./figure": {
      "types": "./dist/figure.d.ts",
      "default": "./dist/figure.jsx"
    },
    "./refs": {
      "types": "./dist/refs.d.ts",
      "default": "./dist/refs.js"
    },
    "./session-config": {
      "types": "./dist/session-config.d.ts",
      "default": "./dist/session-config.js"
    },
    "./tex": {
      "types": "./dist/tex.d.ts",
      "default": "./dist/tex.jsx"
    },
    "./*.css": "./dist/*.css"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "depot": {
    "platform": "browser",
    "target": "lib",
    "depot-version": "0.3.4"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@nota-lang/core": "workspace:*",
    "katex": "^0.16.22",
    "shiki": "^3.9.2"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "jsdom": "^29.1.1",
    "solid-js": "^1.9.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nota-lang/nota.git",
    "directory": "packages/prelude"
  }
}
