{
  "name": "@nota-lang/vite",
  "version": "0.2.1",
  "description": "Vite integration for .nota: a two-plugin preset (transform to Solid JSX + vite-plugin-solid) compiling per build target.",
  "files": [
    "dist"
  ],
  "main": "dist/lib.js",
  "exports": {
    ".": {
      "default": "./dist/lib.js"
    },
    "./*": {
      "default": "./dist/*.js"
    }
  },
  "type": "module",
  "depot": {
    "platform": "node",
    "target": "lib",
    "depot-version": "0.3.4"
  },
  "dependencies": {
    "@nota-lang/compiler": "workspace:*",
    "@nota-lang/core": "workspace:*",
    "@nota-lang/prelude": "workspace:*",
    "@orcid/bibtex-parse-js": "^0.0.25",
    "solid-js": "^1.9.3",
    "vite-plugin-solid": "^2.11.10"
  },
  "peerDependencies": {
    "@solidjs/start": "^2.0.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@solidjs/start": "^2.0.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.16"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nota-lang/nota.git",
    "directory": "packages/vite"
  },
  "peerDependenciesMeta": {
    "@solidjs/start": {
      "optional": true
    }
  }
}
