{
  "name": "@nota-lang/vite",
  "version": "0.2.1",
  "description": "Vite integration for .nota: a two-plugin preset (transform to Solid JSX + @solidjs/vite-plugin) compiling per build target.",
  "files": [
    "dist"
  ],
  "main": "dist/lib.js",
  "exports": {
    ".": {
      "default": "./dist/lib.js"
    },
    "./*": {
      "default": "./dist/*.js"
    }
  },
  "type": "module",
  "depot": {
    "platform": "node",
    "target": "lib",
    "depot-version": "0.3.4"
  },
  "dependencies": {
    "@nota-lang/compiler": "workspace:*",
    "@nota-lang/core": "workspace:*",
    "@nota-lang/prelude": "workspace:*",
    "@orcid/bibtex-parse-js": "^0.0.25",
    "@solidjs/vite-plugin": "3.0.0-next.43",
    "@solidjs/web": "2.0.0-rc.8",
    "solid-js": "2.0.0-rc.8"
  },
  "peerDependencies": {
    "filesystem-routing": "^0.3.1",
    "vite": "^8.0.16"
  },
  "peerDependenciesMeta": {
    "filesystem-routing": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/prerender": "0.2.0",
    "@solidjs/router": "2.0.0-next.24",
    "@tsrx/oxc": "0.13.0",
    "filesystem-routing": "0.3.1",
    "jsdom": "^29.1.1",
    "prerender-crawler": "0.2.0",
    "vite": "^8.0.16"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nota-lang/nota.git",
    "directory": "packages/vite"
  }
}
