{
  "comments": {},
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "$", "close": "$", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["*", "*"],
    ["_", "_"],
    ["$", "$"],
    ["`", "`"]
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*[-+]\\s+.*$",
      "action": { "indent": "none", "appendText": "" }
    }
  ]
}
