{
  "name": "vscode-nota",
  "displayName": "Nota",
  "description": "Language support (syntax highlighting) for the Nota document language.",
  "version": "0.1.0",
  "private": true,
  "publisher": "nota-lang",
  "depot": {
    "platform": "node",
    "target": "lib",
    "depot-version": "0.3.4"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:nota"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nota",
        "aliases": [
          "Nota",
          "nota"
        ],
        "extensions": [
          ".nota"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nota",
        "scopeName": "source.nota",
        "path": "./syntaxes/nota.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.ts": "typescript",
          "meta.embedded.line.ts": "typescript",
          "meta.embedded.block.js": "javascript",
          "meta.embedded.block.json": "json"
        },
        "unbalancedBracketScopes": [
          "keyword.operator.relational",
          "storage.type.function.arrow",
          "keyword.operator.bitwise.shift",
          "meta.brace.angle",
          "punctuation.definition.tag",
          "keyword.operator.assignment.compound.bitwise.ts",
          "markup.inline.raw.code.nota",
          "markup.raw.code.block.nota",
          "markup.math.nota",
          "constant.character.escape.nota"
        ]
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "notaSigil",
        "description": "A Nota markup sigil (`@`, `%`, `*`, `` ` ``, `$`, `|`)"
      },
      {
        "id": "notaTag",
        "description": "A Nota host-element tag name"
      },
      {
        "id": "notaHeadingMarker",
        "description": "A Nota heading marker (`#`)"
      },
      {
        "id": "notaHeading",
        "description": "Nota heading text"
      },
      {
        "id": "notaListMarker",
        "description": "A Nota list marker (`-`)"
      },
      {
        "id": "notaEmphasis",
        "description": "Nota emphasised text (`*`/`_`)"
      },
      {
        "id": "notaMathDelim",
        "description": "A Nota math delimiter (`$`)"
      },
      {
        "id": "notaMath",
        "description": "Nota math content"
      },
      {
        "id": "notaCodeDelim",
        "description": "A Nota code delimiter (`` ` ``)"
      },
      {
        "id": "notaCodeLang",
        "description": "A Nota code-fence language tag"
      },
      {
        "id": "notaCode",
        "description": "Nota code content"
      },
      {
        "id": "notaVerbatim",
        "description": "Nota verbatim content"
      },
      {
        "id": "notaEscape",
        "description": "A Nota escape (`\\x`)"
      },
      {
        "id": "notaStyle",
        "description": "Nota style text"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "notaHeading",
        "description": "Inside a heading"
      },
      {
        "id": "notaStrong",
        "description": "Inside strong emphasis"
      },
      {
        "id": "notaEmphasis",
        "description": "Inside emphasis"
      },
      {
        "id": "notaMath",
        "description": "Inside math"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "notaSigil": [
            "punctuation.definition.tag.nota",
            "keyword.operator"
          ],
          "notaTag": [
            "entity.name.tag"
          ],
          "notaHeadingMarker": [
            "punctuation.definition.heading",
            "markup.heading"
          ],
          "notaHeading": [
            "markup.heading",
            "entity.name.section"
          ],
          "notaListMarker": [
            "punctuation.definition.list.begin",
            "markup.list"
          ],
          "notaEmphasis": [
            "markup.italic",
            "markup.bold"
          ],
          "notaMathDelim": [
            "punctuation.definition.string",
            "string"
          ],
          "notaMath": [
            "markup.inline.raw",
            "string"
          ],
          "notaCodeDelim": [
            "punctuation.definition.raw",
            "string"
          ],
          "notaCodeLang": [
            "entity.name.tag",
            "support.type"
          ],
          "notaCode": [
            "markup.inline.raw",
            "string"
          ],
          "notaVerbatim": [
            "markup.inline.raw",
            "string"
          ],
          "notaEscape": [
            "constant.character.escape"
          ],
          "notaStyle": [
            "source.css",
            "string"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[nota]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "vscode-tmgrammar-test -g ./node_modules/tm-grammars/grammars/typescript.json -g ./node_modules/tm-grammars/grammars/javascript.json -g ./node_modules/tm-grammars/grammars/json.json -g ./syntaxes/nota.tmLanguage.json 'tests/**/*.test.nota'",
    "test:conformance": "node --import tsx tests/conformance.ts",
    "test:all": "pnpm run test && pnpm run test:conformance"
  },
  "dependencies": {
    "@nota-lang/language-server": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@nota-lang/compiler": "workspace:*",
    "@types/vscode": "^1.125.0",
    "tm-grammars": "^1.31.15",
    "typescript": "^6.0.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "vscode-tmgrammar-test": "^0.1.3",
    "esbuild": "^0.28.1",
    "@vscode/vsce": "^3.6.2"
  }
}
