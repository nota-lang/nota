// SYNTAX TEST "source.nota" "line-anchored embedding: percent lines/fences -> source.ts; if/for keyword ONLY; verbatim; math"

// --- % line statement: the % sigil, then the rest of the line delegated to source.ts ---
% const total = items.length
// <- punctuation.definition.statement.nota
//^^^^^ source.ts

// --- %%% fence: line-anchored begin/end delimiters, interior embedded source.ts ---
%%%
