const n = items.length;
//        ^^^^^ source.ts
%%%
// <- punctuation.definition.statement.end.nota

// --- if / for heads: the sigil + control keyword ONLY; the parenthesised head is NOT entered (stays plain) ---
  @if (count > 0) {@p{y}}
//^ punctuation.definition.keyword.nota
// ^^ keyword.control.nota
//   ^^^^^^^^^^^^^^ source.nota - keyword.control.nota
//                 ^ punctuation.definition.tag.nota
//                  ^ entity.name.tag.html.nota
  @for (x of items) {@li{@x}}
//^ punctuation.definition.keyword.nota
// ^^^ keyword.control.nota
//    ^^^^^^^^^^^^^^^ source.nota - keyword.control.nota
