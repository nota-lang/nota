// SYNTAX TEST "source.nota" "fenced code (line-anchored): language-tagged embeds source.ts; untagged stays raw; inline code"

// --- a typescript-tagged fence: line-anchored begin/end, lang tag, embedded source.ts ---
```typescript
// <- punctuation.definition.raw.code.begin.nota
// ^^^^^^^^^^ entity.name.tag.lang.nota
const f = (x: number) => x + 1;
//    ^ source.ts
```
// <- punctuation.definition.raw.code.end.nota

// --- an untagged fence is raw: @ and % stay literal (NEGATIVE: @x inside is NOT interpolation) ---
```
// <- punctuation.definition.raw.code.begin.nota
raw 50% @x stays literal
// <- markup.raw.code.block.nota
//      ^^ markup.raw.code.block.nota - punctuation.definition.interpolation.nota
```
// <- punctuation.definition.raw.code.end.nota

// --- inline `...` code (single-line: opens and closes on the same line) ---
caption `inline` code
//      ^ punctuation.definition.raw.code.begin.nota
//       ^^^^^^ markup.inline.raw.code.nota
//             ^ punctuation.definition.raw.code.end.nota
