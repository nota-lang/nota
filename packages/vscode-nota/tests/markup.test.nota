// SYNTAX TEST "source.nota" "markup: headings (marker + nested emphasis), list markers, word-boundary emphasis, escapes"

// --- heading: # marker + whole-line heading under-layer, with nested *bold* / _em_ ---
# Title with *bold* and _em_
// <- markup.heading.nota punctuation.definition.heading.nota
//^^^^^^^^^^^ markup.heading.nota
//           ^ punctuation.definition.bold.nota
//            ^^^^ markup.bold.nota
//                ^ punctuation.definition.bold.nota
//                 ^^^^^ markup.heading.nota
//                      ^ punctuation.definition.italic.nota
//                       ^^ markup.italic.nota
//                         ^ punctuation.definition.italic.nota

// --- list markers: -, +, N. (marker only; the rest of the line is ordinary markup) ---
- bullet @b{item}
// <- punctuation.definition.list.begin.nota
//       ^ punctuation.definition.tag.nota
//        ^ entity.name.tag.html.nota
+ numbered
// <- punctuation.definition.list.begin.nota
3. explicit
// <- punctuation.definition.list.begin.nota

// --- emphasis fires at word boundaries ---
Para with *strong* and _emph_ here.
//        ^ punctuation.definition.bold.nota
//         ^^^^^^ markup.bold.nota
//               ^ punctuation.definition.bold.nota
//                     ^ punctuation.definition.italic.nota
//                      ^^^^ markup.italic.nota
//                          ^ punctuation.definition.italic.nota

// --- NEGATIVE: intra-word _ and * are NOT emphasis (unpainted; the reader agrees there is none) ---
Literal my_var_name and 2*3*4 stay.
//         ^ source.nota - markup.italic.nota
//                        ^ source.nota - markup.bold.nota
//                          ^ source.nota - markup.bold.nota

// --- escapes: the documented set, both bytes scoped ---
Escapes: \@ \* \_ \{ \} and \\ end.
//       ^^ constant.character.escape.nota
//          ^^ constant.character.escape.nota
//             ^^ constant.character.escape.nota
//                ^^ constant.character.escape.nota
//                   ^^ constant.character.escape.nota
//                          ^^ constant.character.escape.nota
